NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=
PRIMARY_LLM_PROVIDER=nvidia
MONGODB_URI=
MONGODB_DATABASE=maximus
GITHUB_TOKEN=
YOUTUBE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FRONTEND_ORIGIN=http://localhost:5173,https://maximus-ch-indol.vercel.app
# auto checks Atlas once at startup; fallback is reported in every response.
STORAGE_BACKEND=auto
ALLOW_MEMORY_FALLBACK=true
MONGODB_TIMEOUT_MS=3000
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=30
AI_REQUEST_BUDGET_SECONDS=120
LLM_MAX_TOKENS=4096

# Optional public-data integrations; never block the AI workflow.
HIMALAYAS_ENABLED=true
REMOTIVE_ENABLED=true
GITHUB_ENABLED=true
YOUTUBE_ENABLED=true
EXTERNAL_TIMEOUT_SECONDS=8

ARBEITNOW_ENABLED=true
ADZUNA_ENABLED=true
ADZUNA_COUNTRY=in
