  "components": {
    "schemas": {
      "AgentEvent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "agent": {
            "type": "string",
            "title": "Agent"
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "operation_id": {
            "type": "string",
            "title": "Operation Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "agent",
          "status",
          "timestamp",
          "operation_id"
        ],
        "title": "AgentEvent"
      },
      "Assessment": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "learner_id": {
            "type": "string",
            "title": "Learner Id"
          },
          "target_role": {
            "type": "string",
            "title": "Target Role"
          },
          "target_role_source": {
            "type": "string",
            "enum": [
              "learner_selected",
              "ai_suggested"
            ],
            "title": "Target Role Source"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/PublicQuestion"
            },
            "type": "array",
            "title": "Questions"
          },
          "source": {
            "type": "string",
            "const": "ai_generated",
            "title": "Source",
            "default": "ai_generated"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "submitted": {
            "type": "boolean",
            "title": "Submitted",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "learner_id",
          "target_role",
          "target_role_source",
          "questions",
          "provider",
          "model",
          "created_at"
        ],
        "title": "Assessment"
      },
      "AssessmentResponse": {
        "properties": {
          "assessment": {
            "$ref": "#/components/schemas/Assessment"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageStatus"
          }
        },
        "type": "object",
        "required": [
          "assessment",
          "storage"
        ],
        "title": "AssessmentResponse"
      },
      "AssessmentResult": {
        "properties": {
          "assessment_id": {
            "type": "string",
            "title": "Assessment Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "correct": {
            "type": "integer",
            "title": "Correct"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "skill_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Skill Scores"
          },
          "evidence_note": {
            "type": "string",
            "title": "Evidence Note",
            "default": "Score measures this AI-generated quiz only; it is not independent skill verification."
          },
          "submitted_at": {
            "type": "string",
            "title": "Submitted At"
          }
        },
        "type": "object",
        "required": [
          "assessment_id",
          "score",
          "correct",
          "total",
          "skill_scores",
          "submitted_at"
        ],
        "title": "AssessmentResult"
      },
      "Attribution": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "application_url": {
            "type": "string",
            "title": "Application Url"
          }
        },
        "type": "object",
        "required": [
          "source",
          "source_url",
          "application_url"
        ],
        "title": "Attribution"
      },
      "CompletionRequest": {
        "properties": {
          "completed": {
            "type": "boolean",
            "const": true,
            "title": "Completed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "completed"
        ],
        "title": "CompletionRequest"
      },
      "EventsResponse": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/AgentEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageStatus"
          }
        },
        "type": "object",
        "required": [
          "events",
          "storage"
        ],
        "title": "EventsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "JobListing": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "company": {
            "type": "string",
            "title": "Company"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "employment_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Employment Type"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "published_at": {
