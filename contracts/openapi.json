  "components": {
    "schemas": {
      "AgentEvent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "agent": {
            "type": "string",
            "title": "Agent"
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "operation_id": {
            "type": "string",
            "title": "Operation Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "agent",
          "status",
          "timestamp",
          "operation_id"
        ],
        "title": "AgentEvent"
      },
      "Assessment": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "learner_id": {
            "type": "string",
            "title": "Learner Id"
          },
          "target_role": {
            "type": "string",
            "title": "Target Role"
          },
          "target_role_source": {
            "type": "string",
            "enum": [
              "learner_selected",
              "ai_suggested"
            ],
            "title": "Target Role Source"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/PublicQuestion"
            },
            "type": "array",
            "title": "Questions"
          },
          "source": {
            "type": "string",
            "const": "ai_generated",
            "title": "Source",
            "default": "ai_generated"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "submitted": {
            "type": "boolean",
            "title": "Submitted",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "learner_id",
          "target_role",
          "target_role_source",
          "questions",
          "provider",
          "model",
          "created_at"
        ],
        "title": "Assessment"
      },
      "AssessmentResponse": {
        "properties": {
          "assessment": {
            "$ref": "#/components/schemas/Assessment"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageStatus"
          }
        },
        "type": "object",
        "required": [
          "assessment",
          "storage"
        ],
        "title": "AssessmentResponse"
      },
      "AssessmentResult": {
        "properties": {
          "assessment_id": {
            "type": "string",
            "title": "Assessment Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "correct": {
            "type": "integer",
            "title": "Correct"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "skill_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Skill Scores"
          },
          "evidence_note": {
            "type": "string",
            "title": "Evidence Note",
            "default": "Score measures this AI-generated quiz only; it is not independent skill verification."
          },
          "submitted_at": {
            "type": "string",
            "title": "Submitted At"
          }
        },
        "type": "object",
        "required": [
          "assessment_id",
          "score",
          "correct",
          "total",
          "skill_scores",
          "submitted_at"
        ],
        "title": "AssessmentResult"
      },
      "CompletionRequest": {
        "properties": {
          "completed": {
            "type": "boolean",
            "const": true,
            "title": "Completed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "completed"
        ],
        "title": "CompletionRequest"
      },
      "EventsResponse": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/AgentEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageStatus"
          }
        },
        "type": "object",
        "required": [
          "events",
          "storage"
        ],
        "title": "EventsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "Learner": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "track": {
            "type": "string",
            "title": "Track"
          },
          "target_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Role"
          },
          "experience_level": {
            "type": "string",
            "title": "Experience Level"
          },
          "weekly_hours": {
            "type": "integer",
            "title": "Weekly Hours"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/SkillEvidence"
            },
            "type": "array",
            "title": "Skills"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "full_name",
          "track",
          "target_role",
          "experience_level",
          "weekly_hours",
          "skills",
          "created_at"
        ],
        "title": "Learner"
      },
      "LearnerResponse": {
        "properties": {
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageStatus"
          }
        },
        "type": "object",
        "required": [
          "learner",
          "storage"
        ],
        "title": "LearnerResponse"
      },
      "OnboardingRequest": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Full Name"
          },
          "track": {
            "type": "string",
            "enum": [
              "career_first",
              "skills_first"
            ],
            "title": "Track",
            "default": "career_first"
          },
          "target_role": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Role"
          },
          "skills": {
            "items": {
              "type": "string",
              "maxLength": 160,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Skills"
          },
          "experience_level": {
            "type": "string",
            "enum": [
              "entry",
              "mid",
              "senior"
            ],
            "title": "Experience Level",
            "default": "entry"
          },
          "weekly_hours": {
            "type": "integer",
            "maximum": 40.0,
            "minimum": 1.0,
            "title": "Weekly Hours",
            "default": 5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "full_name"
        ],
        "title": "OnboardingRequest"
      },
      "OnboardingResponse": {
        "properties": {
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "session_token": {
            "type": "string",
            "title": "Session Token"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageStatus"
          }
        },
        "type": "object",
        "required": [
          "learner",
          "session_token",
          "storage"
        ],
        "title": "OnboardingResponse"
      },
      "PublicQuestion": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "skill": {
            "type": "string",
            "title": "Skill"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Options"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty"
          }
        },
        "type": "object",
        "required": [
          "id",
          "skill",
          "prompt",
          "options",
          "difficulty"
        ],
        "title": "PublicQuestion"
      },
      "ResultResponse": {
        "properties": {
          "result": {
            "$ref": "#/components/schemas/AssessmentResult"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageStatus"
          }
        },
        "type": "object",
        "required": [
          "result",
          "storage"
        ],
        "title": "ResultResponse"
      },
      "Roadmap": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "learner_id": {
            "type": "string",
            "title": "Learner Id"
          },
          "assessment_id": {
            "type": "string",
            "title": "Assessment Id"
          },
          "target_role": {
            "type": "string",
            "title": "Target Role"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/RoadmapStep"
            },
            "type": "array",
            "title": "Steps"
          },
          "source": {
            "type": "string",
            "const": "ai_generated",
            "title": "Source",
            "default": "ai_generated"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "revision": {
            "type": "integer",
            "title": "Revision",
            "default": 1
          },
          "progress_source": {
            "type": "string",
            "const": "learner_reported",
            "title": "Progress Source",
            "default": "learner_reported"
          }
        },
        "type": "object",
        "required": [
          "id",
          "learner_id",
          "assessment_id",
          "target_role",
          "summary",
          "steps",
          "provider",
          "model",
          "created_at"
        ],
        "title": "Roadmap"
      },
      "RoadmapResponse": {
        "properties": {
          "roadmap": {
            "$ref": "#/components/schemas/Roadmap"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageStatus"
          }
        },
        "type": "object",
        "required": [
          "roadmap",
          "storage"
        ],
