    "/api/v1/integrations/github/{owner}/{repo}": {
      "get": {
        "tags": [
          "optional integrations"
        ],
        "summary": "Github",
        "operationId": "github_api_v1_integrations_github__owner___repo__get",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
